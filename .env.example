# Listen address for Next.js. Do not hardcode port/host in package.json scripts.
# HOSTNAME is the bind address (0.0.0.0 / 127.0.0.1), not the OS machine name.
NODE_ENV=development
PORT=3001
HOSTNAME=0.0.0.0

# Optional public origin if you add auth later (not HOSTNAME:PORT).
# SITE_PUBLIC_URL=http://localhost:3001
